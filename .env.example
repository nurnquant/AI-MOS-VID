# AIVS local environment template. Copy to .env and adjust.
# NEVER commit .env — only this example file is tracked.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (local Docker defaults — not production credentials)
DATABASE_URL=postgresql://aivs:aivs_local@localhost:5433/aivs
POSTGRES_USER=aivs
POSTGRES_PASSWORD=aivs_local
POSTGRES_DB=aivs
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# Object Storage (local MinIO defaults — not production credentials)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aivs-assets
S3_ACCESS_KEY_ID=aivs_local
S3_SECRET_ACCESS_KEY=aivs_local_secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=aivs_local
MINIO_ROOT_PASSWORD=aivs_local_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Provider selection (ADR-AIVS-009). Every slot defaults to mock; real
# values (e.g. SCRIPT_PROVIDER=anthropic) only after that phase is
# user-approved and the matching API key is set.
SCRIPT_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
PUBLISH_PROVIDER=mock
# Still-image source for VIDEO_PROVIDER=slideshow (SLIDESHOW-015):
# mock (free placeholder) | fal (needs FAL_API_KEY)
IMAGE_PROVIDER=mock

# Provider budget caps in USD (ADR-AIVS-009 §2). Unset, 0, or invalid =
# ZERO budget: real provider calls fail closed. Mocks never spend.
PROVIDER_DAILY_BUDGET_USD=0
PROVIDER_MONTHLY_BUDGET_USD=0

# Hardening (ADR-AIVS-011). Scanning: off (logged) | clamav
# (local: docker compose --profile scan up -d clamav).
SCAN_PROVIDER=off
CLAMAV_HOST=
CLAMAV_PORT=
# Email: console (logs) | resend (needs RESEND_API_KEY + RESEND_FROM_EMAIL)
EMAIL_PROVIDER=console
# When true, the §10 guardian-scope check also requires the guardian's
# email confirmation. Flip only once real guardians confirm.
ENFORCE_GUARDIAN_CONFIRMATION=false

# Future providers — leave empty locally. Fill only with user approval,
# never commit real values.

# LLM / general AI
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY
OPENAI_API_KEY=

# Video generation — Google Veo via Vertex AI (or available Google video service)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VEO_API_KEY=
# Video generation — aggregator (recommended first adapter: fal.ai)
FAL_API_KEY=
# Model + cost knobs when VIDEO_PROVIDER=fal (see PROVIDER-ENABLEMENT.md;
# check current model pricing at fal.ai/models before enabling)
FAL_VIDEO_MODEL=
FAL_USD_PER_SECOND=
# Image model knobs when IMAGE_PROVIDER=fal (slideshow mode; default
# fal-ai/flux/schnell, ~$0.003-0.01 per image)
FAL_IMAGE_MODEL=
FAL_USD_PER_IMAGE=
VIDEO_POLL_INTERVAL_MS=
VIDEO_POLL_TIMEOUT_MS=
# Video generation — direct vendors
KLING_API_KEY=
RUNWAY_API_KEY=

# Voice + music (ElevenLabs primary; Azure Speech for Arabic bake-off)
ELEVENLABS_API_KEY=
# Voice used for narration when VOICE_PROVIDER=elevenlabs (a real
# ElevenLabs voice id); model + pricing overrides optional.
VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_USD_PER_1K_CHARS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Azure voice for VOICE_PROVIDER=azure (default ar-SA-ZariyahNeural)
AZURE_VOICE_NAME=
AZURE_USD_PER_1K_CHARS=

# Production object storage — Cloudflare R2 (S3-compatible; swaps in for MinIO)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Supabase (managed Postgres / auth / realtime — future option)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Publishing platforms (official APIs)
# YouTube — real adapter (PROV-009D). Get client id/secret from Google
# Cloud Console (Desktop OAuth client + YouTube Data API v3), then run
# `node --env-file=.env scripts/youtube-oauth.mjs` for the refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# unlisted (default) | private | public
YOUTUBE_PRIVACY_STATUS=
# Placeholders — later phases, each needs its own approval:
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Auth (AIVS-AUTH-003)
BETTER_AUTH_SECRET=generate-a-long-random-string
